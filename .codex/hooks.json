{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "qew hook pre-tool --agent codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "qew hook post-tool --agent codex",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "qew hook session-start --agent codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
