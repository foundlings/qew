{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "qew hook pre-shell --agent codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "qew hook post-shell --agent codex",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
