{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "pre-tool",
              "--agent",
              "claude"
            ],
            "command": "qew",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "post-tool",
              "--agent",
              "claude"
            ],
            "command": "qew",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "session-start",
              "--agent",
              "claude"
            ],
            "command": "qew",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
